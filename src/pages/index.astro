---
import SiteLayout from '../layouts/SiteLayout.astro';
import ReadingDashboard from '../components/ReadingDashboard';
import { notes, rootNotes, categories, noteUrl, url } from '../lib/content';
---
<SiteLayout title="知识目录">
  <main id="main" class="home-main">
    <section class="home-hero"><div><div class="hero-kicker"><span class="tiny-square" /> YOUR PERSONAL KNOWLEDGE SHELF</div><h1>把基础知识，<br />读成自己的理解<span>。</span></h1><p>算法、系统、网络与编程。<br />让零散的知识，慢慢连成一张完整的地图。</p><div class="hero-meta"><span>{notes.length.toString().padStart(2,'0')} 篇已收录笔记</span><span>09 个知识分类</span><span>记录你的阅读</span></div></div><ReadingDashboard compact client:load /></section>
    <section class="catalog-section"><div class="section-title"><div><span class="eyebrow">THE COLLECTION</span><h2>从这里开始</h2></div><p>选择一个方向，深入一个知识点。</p></div>
      <div class="category-grid">{categories.map(category => { const count = notes.filter(n => n.categoryId === category.id).length; return <a class="category-card" href={url(`category/${category.id}.html`)}><span class="category-number">{category.number}</span><div><h3>{category.title}</h3><p>{category.detail}</p></div><div class="category-bottom"><span>{count ? `${count} 篇笔记` : '等待收录'}</span><span aria-hidden="true">↗</span></div></a>; })}</div>
    </section>
    <section class="chapter-section"><div class="section-title"><div><span class="eyebrow">START READING</span><h2>主题与章节目录</h2></div><a class="text-link" href={url('reading.html')}>我的阅读 ↗</a></div><div class="chapter-list">{rootNotes.map((note, index) => <a href={noteUrl(note)}><span class="chapter-order">{String(index + 1).padStart(2, '0')}</span><span><strong>{note.title}</strong><small>{note.category}</small></span><span class="chapter-arrow">→</span></a>)}</div></section>
  </main>
</SiteLayout>
