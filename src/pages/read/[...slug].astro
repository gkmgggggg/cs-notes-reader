---
import { getCollection, render } from 'astro:content';
import ReaderLayout from '../../layouts/ReaderLayout.astro';
export async function getStaticPaths() {
  return (await getCollection('notes')).map(entry => ({ params: { slug: entry.data.route }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<ReaderLayout note={entry.data} headings={headings}><Content /></ReaderLayout>
