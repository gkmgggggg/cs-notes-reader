{
  "name": "cs-notes-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "content:sync": "tsx scripts/sync-content.ts",
    "content:check": "tsx scripts/validate-content.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "build": "npm run content:check && ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist && tsx scripts/validate-output.ts",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@nanostores/react": "2.0.1",
    "astro": "7.3.8",
    "nanostores": "1.5.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pagefind": "1.5.2",
    "parse5": "7.3.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unified": "11.0.5"
  }
}
